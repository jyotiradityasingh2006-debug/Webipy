# Example environment variables.
# On Render, add these in Dashboard -> your service -> Environment.
# On your machine, export them before `npm start` (they are not auto-loaded).

# MongoDB Atlas connection string. When set, all data is stored in MongoDB.
# Leave unset to keep using local JSON files in ./data.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=webipy

# Password used until you change it from the admin dashboard.
ADMIN_PASSWORD=change-me

# Comma-separated origins allowed to call the API. Use your Vercel URL
# (or Netlify URL), e.g. https://webipy.vercel.app.
# Leave empty to allow any origin.
CORS_ORIGIN=https://your-site.vercel.app
